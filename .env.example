# Copy to .env and adjust. Every setting is described in docs/configuration.md.

# ---- Container -------------------------------------------------------------------------
# Time zone for logs and dates.
TZ=Europe/Berlin
# Port on the host the app is reachable at (http://<host>:8087).
SIDURI_PORT=8087

# ---- Accounts --------------------------------------------------------------------------
# The app has one shared brewery: the first account created becomes the admin. Turn this on
# to let more people (e.g. a brewing partner) create their own login for the same data.
ALLOW_REGISTRATION=false
# Public address, when the app runs behind a reverse proxy with HTTPS (e.g. https://siduri.example.com).
# BASE_URL=
# Send the session cookie only over HTTPS. Defaults to true when BASE_URL starts with https://.
# COOKIE_SECURE=
# Days a login stays valid without being used.
SESSION_DAYS=30
# Trust X-Forwarded-* headers (set when behind a reverse proxy).
TRUST_PROXY=false

# ---- Optional database encryption -------------------------------------------------------
# Encrypts the database file (SQLCipher). Off when empty. Generate with: openssl rand -hex 32
# Once set, it can't be removed or changed without exporting your data first.
# ENCRYPTION_KEY=
# Or read the key from a file (Docker secret).
# ENCRYPTION_KEY_FILE=


# ---- Logging -----------------------------------------------------------------------------
# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
